<div class="col-12 col-lg-6">
  <div class="blog-listing__card-t4">
    <div class="blog-listing__card-img-t4">
      {{{media id=(mediaId element="Image") layout="image/*"}}}
    </div>
    <div class="blog-listing__card-body-t4">
      <div class="card-content">
        <h3><a href="{{extractHref (fulltext linkText="Title")}}">{{publish element="Title"}}</a></h3>
        <p>{{publish element="Abstract"}}</p>
      </div>
      <div class="card-meta">
        <p>{{dateFormat (dateElement element="Published Date") "MMMM d, yyyy" }}
          
          {{#ifSet element="Author"}}
          by {{publish element="Author"}}{{/ifSet}}
        </p>
        
        
        <a href="{{extractHref (fulltext linkText="Title")}}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="#B32473">
          <title>Link to {{publish element="Title"}}</title>
          <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"></path>
          </svg></a>
      </div>
    </div>
  </div>
</div>