<script>
  (function () {
  function openAccordionFromHash() {
    const hash = window.location.hash;
    if (!hash || hash.length < 2) return;

    const id = decodeURIComponent(hash.slice(1));
    const anchorEl = document.getElementById(id);
    if (!anchorEl) return;

    const accordionItem = anchorEl.closest("li.tabs__content");
    if (!accordionItem) return;

    const toggleBtn = accordionItem.querySelector(":scope > button.tabs__nav-link");
    if (!toggleBtn) return;

    const alreadyOpen =
      toggleBtn.getAttribute("aria-expanded") === "true" ||
      accordionItem.classList.contains("is-active") ||
      toggleBtn.classList.contains("is-active");

    if (!alreadyOpen) {
      toggleBtn.click();

      setTimeout(() => {
        anchorEl.scrollIntoView({ block: "start", behavior: "smooth" });
      }, 50);
    }

    toggleBtn.focus({ preventScroll: true });
  }

  window.addEventListener("DOMContentLoaded", () => {
    if (window.location.hash) setTimeout(openAccordionFromHash, 0);
  });

  window.addEventListener("hashchange", () => setTimeout(openAccordionFromHash, 0));
})();
</script>

